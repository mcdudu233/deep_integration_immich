{
    "name": "deep_integration_immich",
    "version": "2.0.0",
    "description": "Deep Integration Immich for Nextcloud",
    "license": "AGPL-3.0-or-later",
    "private": true,
    "scripts": {
        "build": "node build-l10n.mjs && webpack --mode production --progress",
        "build-l10n": "node build-l10n.mjs",
        "dev": "node build-l10n.mjs && webpack --mode development --progress",
        "watch": "node build-l10n.mjs && webpack --mode development --watch --progress",
        "serve": "node build-l10n.mjs && webpack --mode development serve --progress",
        "l10n": "npm run build-l10n",
        "verify": "npm run verify:backend && npm run verify:safety",
        "verify:ci": "npm run verify:backend && npm run build && npm run verify:safety",
        "verify:backend": "npm run verify:php-syntax && npm run verify:phpunit",
        "verify:php-syntax": "node scripts/verify-php-syntax.mjs",
        "verify:phpunit": "vendor/bin/phpunit -c tests/phpunit.xml",
        "verify:safety": "npm run verify:safety:scan && npm run verify:admin-settings-payload && npm run verify:localization && npm run verify:safety:phpunit",
        "verify:safety:scan": "node scripts/verify-safety-scan.mjs",
        "verify:admin-settings-payload": "node scripts/verify-admin-settings-payload.mjs",
        "verify:localization": "node scripts/verify-localization-guardrail.mjs",
        "verify:safety:phpunit": "vendor/bin/phpunit -c tests/phpunit.xml --filter SafetyGuardrailTest"
    },
    "dependencies": {
        "@nextcloud/axios": "^2.6.0",
        "@nextcloud/dialogs": "^7.4.0",
        "@nextcloud/files": "^4.0.0",
        "@nextcloud/files-v3": "npm:@nextcloud/files@^3.12.2",
        "@nextcloud/initial-state": "^3.0.0",
        "@nextcloud/l10n": "^3.1.0",
        "@nextcloud/router": "^3.0.1",
        "@nextcloud/vue": "^9.7.0",
        "leaflet": "^1.9.4",
        "pinia": "^3.0.4",
        "vue": "^3.5.33",
        "vue-material-design-icons": "^5.3.0",
        "vue-router": "^5.0.7"
    },
    "devDependencies": {
        "@babel/core": "^7.22.9",
        "@nextcloud/browserslist-config": "^3.0.1",
        "@nextcloud/eslint-config": "^8.4.1",
        "@nextcloud/webpack-vue-config": "^7.0.0",
        "babel-loader": "^10.0.0",
        "css-loader": "^7.1.1",
        "eslint-webpack-plugin": "^6.0.0",
        "node-polyfill-webpack-plugin": "4.0.0",
        "sass": "^1.64.2",
        "sass-loader": "^16.0.2",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.4.4",
        "vue-loader": "^17.4.2",
        "webpack": "^5.88.2",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.0.2"
    },
    "browserslist": [
        "extends @nextcloud/browserslist-config"
    ]
}
